# ==============================
# SDHP API — Environment Example
# ==============================
# Copy this file to .env and fill in the values.
# Only DATABASE_URL and JWT_SECRET are required to run the API.

# ── Database (required) ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sdhp?schema=public"

# ── Auth (required) ────────────────────────────────────────────────────────────
JWT_SECRET="change-this-in-production"
JWT_EXPIRES_IN="7d"

# ── Server (required) ──────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT=3001
FRONTEND_URL="http://localhost:3000"

# ── Object storage (optional for local dev — required for file uploads) ───────
# In production these are set automatically via docker-compose.prod.yml.
# For local development without Docker, start MinIO manually and set these:
# MINIO_ENDPOINT=localhost          # hostname only, no protocol or port
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=minioadmin       # matches MINIO_ROOT_USER in docker/.env
# MINIO_SECRET_KEY=minioadmin       # matches MINIO_ROOT_PASSWORD in docker/.env
# MINIO_BUCKET=sdhp-files
# MINIO_PUBLIC_ENDPOINT=            # browser-reachable base URL for presigned URLs
#                                   # e.g. https://yourdomain.com/minio
#                                   # omit (leave unset) for local dev

# ── Optional / future use ──────────────────────────────────────────────────────
# Redis is not used by the API yet. Included here for future caching support.
# REDIS_URL="redis://localhost:6379"
