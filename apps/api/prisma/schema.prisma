generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  BRANCH_ADMIN
  DOCTOR
  NURSE
  SECRETARY
  ACCOUNTANT
  TECHNICIAN
}

enum Gender {
  MALE
  FEMALE
}

enum OrganizationType {
  HOSPITAL
  CLINIC
  POLYCLINIC
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_QUEUE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

enum QueueStatus {
  WAITING
  CALLED
  IN_PROGRESS
  DONE
  SKIPPED
}

enum MedicalTimelineEventType {
  PATIENT_CREATED
  PATIENT_UPDATED
  PATIENT_ARCHIVED
  APPOINTMENT_BOOKED
  FOLLOW_UP_BOOKED
  CHECKED_IN
  QUEUE_JOINED
  ENCOUNTER_STARTED
  ENCOUNTER_COMPLETED
  PRESCRIPTION_ADDED
  LAB_ORDERED
  LAB_RESULT_ADDED
  RADIOLOGY_ORDERED
  RADIOLOGY_REPORT_ADDED
  LAB_RESULT_REVIEWED
  RADIOLOGY_REPORT_REVIEWED
  MEDICAL_FILE_UPLOADED
  CLINICAL_REPORT_CREATED
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  IN_PROGRESS
  RESULTED
  REVIEWED
  CANCELLED
}

enum RadiologyOrderStatus {
  ORDERED
  SCHEDULED
  IN_PROGRESS
  RESULTED
  REVIEWED
  CANCELLED
}

enum ClinicalReportStatus {
  DRAFT
  FINALIZED
}

enum VisitTypeCode {
  CONSULTATION
  FOLLOW_UP
  EMERGENCY
  PROCEDURE
  FREE_VISIT
}

enum ScheduleExceptionType {
  HOLIDAY
  LEAVE
  CUSTOM_HOURS
}

enum ReminderChannel {
  IN_APP
  SMS
  WHATSAPP
  EMAIL
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum PatientResponseStatus {
  CONFIRMED
  NO_RESPONSE
  DECLINED
  RESCHEDULE_REQUESTED
}

enum ClinicPatientStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  REVOKED
}

enum ClinicPatientLinkType {
  CLINIC_CREATED
  PATIENT_VERIFIED
  IMPORTED
  INVITED
}

// ─────────────────────────────────────────────
// ORGANIZATIONS & BRANCHES
// ─────────────────────────────────────────────

model Organization {
  id       String           @id @default(cuid())
  name     String
  nameAr   String?
  type     OrganizationType @default(CLINIC)
  phone    String?
  email    String?
  address  String?
  logoUrl  String?
  isActive Boolean          @default(true)
  settings Json             @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches              Branch[]
  users                 User[]
  departments           Department[]
  patients              Patient[]
  appointments          Appointment[]
  queueEntries          QueueEntry[]
  auditLogs             AuditLog[]
  labOrders             LabOrder[]
  radiologyOrders       RadiologyOrder[]
  medicalFiles          MedicalFile[]
  invoices              Invoice[]
  medicalTimelineEvents MedicalTimelineEvent[]
  clinicalReports       ClinicalReport[]
  clinicSettings        ClinicSettings?
  visitTypes            VisitType[]
  services              Service[]
  followUpReminders     FollowUpReminder[]
  billingPolicy         BillingPolicy?
  clinicPatients        ClinicPatient[]

  @@map("organizations")
}

model Branch {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  nameAr         String?
  phone          String?
  address        String?
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id])
  users           User[]
  departments     Department[]
  appointments    Appointment[]
  labOrders       LabOrder[]
  radiologyOrders RadiologyOrder[]
  invoices        Invoice[]

  @@index([organizationId])
  @@map("branches")
}

// ─────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  phone          String    @unique
  email          String?   @unique
  passwordHash   String
  firstName      String
  lastName       String
  firstNameAr    String?
  lastNameAr     String?
  role           UserRole  @default(SECRETARY)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization           Organization           @relation(fields: [organizationId], references: [id])
  branch                 Branch?                @relation(fields: [branchId], references: [id])
  doctor                 Doctor?
  auditLogs              AuditLog[]
  uploadedFiles          MedicalFile[]
  createdInvoices        Invoice[]              @relation("InvoicesCreated")
  receivedPayments       Payment[]              @relation("PaymentsReceived")
  voidedPayments         Payment[]              @relation("PaymentsVoided")
  timelineEventsCreated  MedicalTimelineEvent[] @relation("TimelineEventsCreated")
  createdClinicalReports ClinicalReport[]
  linkedClinicPatients   ClinicPatient[]        @relation("ClinicPatientLinkedBy")

  @@index([organizationId])
  @@map("users")
}

// ─────────────────────────────────────────────
// DEPARTMENTS & STAFF
// ─────────────────────────────────────────────

model Department {
  id             String  @id @default(cuid())
  organizationId String
  branchId       String?
  name           String
  nameAr         String?
  code           String?
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  doctors      Doctor[]
  services     Service[]

  @@index([organizationId])
  @@map("departments")
}

model Doctor {
  id                  String  @id @default(cuid())
  userId              String  @unique
  departmentId        String?
  specialization      String?
  licenseNumber       String?
  consultationMinutes Int     @default(15)
  maxPatientsPerDay   Int?
  isActive            Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user                     User                      @relation(fields: [userId], references: [id])
  department               Department?               @relation(fields: [departmentId], references: [id])
  appointments             Appointment[]
  encounters               Encounter[]
  orderedLabOrders         LabOrder[]                @relation("LabOrdersOrdered")
  reviewedLabResults       LabResult[]               @relation("LabResultsReviewed")
  orderedRadiologyOrders   RadiologyOrder[]          @relation("RadiologyOrdersOrdered")
  reportedRadiologyReports RadiologyReport[]         @relation("RadiologyReportsReported")
  reviewedRadiologyReports RadiologyReport[]         @relation("RadiologyReportsReviewed")
  schedules                DoctorSchedule[]
  scheduleExceptions       DoctorScheduleException[]

  @@map("doctors")
}

// ─────────────────────────────────────────────
// PATIENTS
// ─────────────────────────────────────────────

model Patient {
  id              String    @id @default(cuid())
  organizationId  String
  mrn             String
  firstName       String
  lastName        String
  firstNameAr     String?
  lastNameAr      String?
  fatherName      String?
  fatherNameAr    String?
  motherName      String?
  motherNameAr    String?
  dateOfBirth     DateTime?
  gender          Gender?
  phone           String?
  email           String?
  nationalId      String?
  bloodType       String?
  address         String?
  city            String?
  chronicDiseases String?
  emergencyName   String?
  emergencyPhone  String?
  isActive        Boolean   @default(true)
  notes           String?
  platformId      String?   @unique
  hasPortalAccess Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization      Organization           @relation(fields: [organizationId], references: [id])
  allergies         Allergy[]
  appointments      Appointment[]
  encounters        Encounter[]
  labOrders         LabOrder[]
  radiologyOrders   RadiologyOrder[]
  medicalFiles      MedicalFile[]
  invoices          Invoice[]
  clinicalReports   ClinicalReport[]
  timelineEvents    MedicalTimelineEvent[]
  followUpReminders FollowUpReminder[]
  clinicLinks       ClinicPatient[]

  @@unique([organizationId, mrn])
  @@index([organizationId])
  @@index([organizationId, firstName])
  @@index([organizationId, lastName])
  @@index([organizationId, phone])
  @@index([organizationId, nationalId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, isActive])
  @@index([nationalId])
  @@index([phone])
  @@map("patients")
}

model MedicalTimelineEvent {
  id             String                   @id @default(cuid())
  organizationId String
  patientId      String
  createdById    String?
  eventType      MedicalTimelineEventType
  metadata       Json?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  createdBy    User?        @relation("TimelineEventsCreated", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([patientId])
  @@index([organizationId, patientId])
  @@map("medical_timeline_events")
}

model Allergy {
  id        String           @id @default(cuid())
  patientId String
  substance String
  reaction  String?
  severity  AllergySeverity?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("allergies")
}

model ClinicPatient {
  id                    String                @id @default(cuid())
  organizationId        String
  patientId             String
  mrn                   String
  localNotes            String?
  linkType              ClinicPatientLinkType @default(CLINIC_CREATED)
  status                ClinicPatientStatus   @default(ACTIVE)
  registrationSource    String?
  consentGiven          Boolean               @default(false)
  consentAt             DateTime?
  verificationCodeHash  String?
  verificationExpiresAt DateTime?
  linkedAt              DateTime              @default(now())
  linkedById            String?
  lastVisitAt           DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  linkedBy     User?        @relation("ClinicPatientLinkedBy", fields: [linkedById], references: [id])

  @@unique([organizationId, patientId])
  @@unique([organizationId, mrn])
  @@index([organizationId])
  @@index([patientId])
  @@index([organizationId, status])
  @@map("clinic_patients")
}

// ─────────────────────────────────────────────
// APPOINTMENTS & QUEUE
// ─────────────────────────────────────────────

model Appointment {
  id                String            @id @default(cuid())
  organizationId    String
  branchId          String?
  patientId         String
  doctorId          String
  visitTypeId       String?
  sourceEncounterId String?
  scheduledAt       DateTime
  durationMin       Int               @default(15)
  status            AppointmentStatus @default(SCHEDULED)
  notes             String?
  cancelledAt       DateTime?
  cancelReason      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization    Organization       @relation(fields: [organizationId], references: [id])
  branch          Branch?            @relation(fields: [branchId], references: [id])
  patient         Patient            @relation(fields: [patientId], references: [id])
  doctor          Doctor             @relation(fields: [doctorId], references: [id])
  visitType       VisitType?         @relation(fields: [visitTypeId], references: [id])
  sourceEncounter Encounter?         @relation("FollowUpAppointments", fields: [sourceEncounterId], references: [id])
  queueEntry      QueueEntry?
  encounter       Encounter?
  invoices        Invoice[]
  reminders       FollowUpReminder[]

  @@index([organizationId])
  @@index([doctorId])
  @@index([visitTypeId])
  @@index([scheduledAt])
  @@index([patientId])
  @@index([sourceEncounterId])
  @@map("appointments")
}

model QueueEntry {
  id             String      @id @default(cuid())
  appointmentId  String      @unique
  organizationId String
  businessDate   String // YYYY-MM-DD in Asia/Damascus — used for daily ticket reset
  ticketNumber   Int
  status         QueueStatus @default(WAITING)
  calledAt       DateTime?
  completedAt    DateTime?
  deletedAt      DateTime?
  deletedBy      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  appointment  Appointment  @relation(fields: [appointmentId], references: [id])

  @@unique([organizationId, businessDate, ticketNumber])
  @@index([organizationId])
  @@map("queue_entries")
}

// ─────────────────────────────────────────────
// ENCOUNTERS (Medical Visits)
// ─────────────────────────────────────────────

model Encounter {
  id                      String    @id @default(cuid())
  organizationId          String
  branchId                String?
  patientId               String
  doctorId                String
  appointmentId           String?   @unique
  chiefComplaint          String?
  historyOfPresentIllness String?
  notes                   String?
  diagnosis               String?
  diagnosisCode           String?
  treatmentPlan           String?
  patientInstructions     String?
  followUpDate            DateTime?
  vitals                  Json?
  startedAt               DateTime  @default(now())
  endedAt                 DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  patient              Patient            @relation(fields: [patientId], references: [id])
  doctor               Doctor             @relation(fields: [doctorId], references: [id])
  appointment          Appointment?       @relation(fields: [appointmentId], references: [id])
  followUpAppointments Appointment[]      @relation("FollowUpAppointments")
  prescriptions        Prescription[]
  labOrders            LabOrder[]
  radiologyOrders      RadiologyOrder[]
  medicalFiles         MedicalFile[]
  invoices             Invoice[]
  clinicalReports      ClinicalReport[]
  reminders            FollowUpReminder[]

  @@index([organizationId])
  @@index([doctorId])
  @@index([patientId])
  @@index([organizationId, followUpDate])
  @@index([organizationId, doctorId, followUpDate])
  @@map("encounters")
}

// ─────────────────────────────────────────────
// PRESCRIPTIONS
// ─────────────────────────────────────────────

model Prescription {
  id           String  @id @default(cuid())
  encounterId  String
  medication   String
  dosage       String?
  frequency    String?
  duration     String?
  instructions String?
  quantity     Int?
  refillsLeft  Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([encounterId])
  @@map("prescriptions")
}

// ─────────────────────────────────────────────
// LABS
// ─────────────────────────────────────────────

model LabOrder {
  id             String         @id @default(cuid())
  organizationId String
  branchId       String?
  patientId      String
  encounterId    String?
  orderedById    String
  testName       String
  testCode       String?
  clinicalInfo   String?
  status         LabOrderStatus @default(ORDERED)
  priority       String?
  notes          String?
  collectedAt    DateTime?
  cancelReason   String?
  cancelledAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  encounter    Encounter?   @relation(fields: [encounterId], references: [id])
  orderedBy    Doctor       @relation("LabOrdersOrdered", fields: [orderedById], references: [id])
  result       LabResult?

  @@index([organizationId])
  @@index([patientId])
  @@index([encounterId])
  @@index([orderedById])
  @@index([status])
  @@map("lab_orders")
}

model LabResult {
  id             String    @id @default(cuid())
  labOrderId     String    @unique
  resultValue    String?
  unit           String?
  referenceRange String?
  interpretation String?
  resultNotes    String?
  resultAt       DateTime  @default(now())
  reviewedById   String?
  reviewedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  labOrder   LabOrder @relation(fields: [labOrderId], references: [id])
  reviewedBy Doctor?  @relation("LabResultsReviewed", fields: [reviewedById], references: [id])

  @@map("lab_results")
}

// ─────────────────────────────────────────────
// RADIOLOGY
// ─────────────────────────────────────────────

model RadiologyOrder {
  id             String               @id @default(cuid())
  organizationId String
  branchId       String?
  patientId      String
  encounterId    String?
  orderedById    String
  modality       String
  bodyPart       String?
  clinicalInfo   String?
  priority       String?
  notes          String?
  status         RadiologyOrderStatus @default(ORDERED)
  scheduledAt    DateTime?
  cancelReason   String?
  cancelledAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id])
  branch       Branch?          @relation(fields: [branchId], references: [id])
  patient      Patient          @relation(fields: [patientId], references: [id])
  encounter    Encounter?       @relation(fields: [encounterId], references: [id])
  orderedBy    Doctor           @relation("RadiologyOrdersOrdered", fields: [orderedById], references: [id])
  report       RadiologyReport?

  @@index([organizationId])
  @@index([patientId])
  @@index([encounterId])
  @@index([orderedById])
  @@index([status])
  @@map("radiology_orders")
}

model RadiologyReport {
  id               String    @id @default(cuid())
  radiologyOrderId String    @unique
  findings         String?
  impression       String?
  reportedById     String?
  reportedAt       DateTime  @default(now())
  reviewedById     String?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  radiologyOrder RadiologyOrder @relation(fields: [radiologyOrderId], references: [id])
  reportedBy     Doctor?        @relation("RadiologyReportsReported", fields: [reportedById], references: [id])
  reviewedBy     Doctor?        @relation("RadiologyReportsReviewed", fields: [reviewedById], references: [id])

  @@map("radiology_reports")
}

// ─────────────────────────────────────────────
// MEDICAL FILES
// ─────────────────────────────────────────────

enum MedicalFileCategory {
  LAB_RESULT
  RADIOLOGY_IMAGE
  PRESCRIPTION
  REFERRAL
  DISCHARGE_SUMMARY
  CONSENT_FORM
  INSURANCE
  CLINICAL_NOTE
  CLINICAL_REPORT
  ID_DOCUMENT
  OTHER
}

model MedicalFile {
  id             String              @id @default(cuid())
  organizationId String
  patientId      String
  encounterId    String?
  uploadedById   String
  category       MedicalFileCategory
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String              @unique
  description    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  encounter    Encounter?   @relation(fields: [encounterId], references: [id])
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  @@index([organizationId])
  @@index([patientId])
  @@index([encounterId])
  @@index([uploadedById])
  @@index([category])
  @@map("medical_files")
}

// ─────────────────────────────────────────────
// CLINICAL REPORTS
// ─────────────────────────────────────────────

model ClinicalReport {
  id             String               @id @default(cuid())
  organizationId String
  patientId      String
  encounterId    String
  createdById    String
  title          String
  content        String
  status         ClinicalReportStatus @default(DRAFT)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  encounter    Encounter    @relation(fields: [encounterId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([patientId])
  @@index([encounterId])
  @@index([createdById])
  @@index([status])
  @@index([deletedAt])
  @@map("clinical_reports")
}

// ─────────────────────────────────────────────
// BILLING
// ─────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  INSURANCE
  OTHER
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  branchId       String?
  patientId      String
  appointmentId  String?
  encounterId    String?
  createdById    String
  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(10, 2)
  notes          String?
  issuedAt       DateTime?
  dueDate        DateTime?
  cancelledAt    DateTime?
  cancelReason   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])
  encounter    Encounter?    @relation(fields: [encounterId], references: [id])
  createdBy    User          @relation("InvoicesCreated", fields: [createdById], references: [id])
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([patientId])
  @@index([encounterId])
  @@index([appointmentId])
  @@index([createdById])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  visitTypeId String?
  serviceId   String?
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice   Invoice    @relation(fields: [invoiceId], references: [id])
  visitType VisitType? @relation(fields: [visitTypeId], references: [id])
  service   Service?   @relation(fields: [serviceId], references: [id])

  @@index([invoiceId])
  @@index([visitTypeId])
  @@index([serviceId])
  @@map("invoice_items")
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod
  referenceNumber String?
  notes           String?
  paidAt          DateTime      @default(now())
  receivedById    String
  voidedAt        DateTime?
  voidReason      String?
  voidedById      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  receivedBy User    @relation("PaymentsReceived", fields: [receivedById], references: [id])
  voidedBy   User?   @relation("PaymentsVoided", fields: [voidedById], references: [id])

  @@index([invoiceId])
  @@index([receivedById])
  @@index([voidedById])
  @@map("payments")
}

model BillingPolicy {
  id                            String  @id @default(cuid())
  organizationId                String  @unique
  autoCreateInvoiceOnCheckin    Boolean @default(true)
  freeFollowUpWindowDays        Int     @default(0)
  followUpDiscountPercent       Decimal @default(0) @db.Decimal(5, 2)
  requirePaymentBeforeEncounter Boolean @default(false)
  defaultDueDateDays            Int     @default(0)
  noShowFeeAmount               Decimal @default(0) @db.Decimal(10, 2)
  invoiceNumberPrefix           String  @default("INV")
  nextInvoiceSequence           Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("billing_policies")
}

// ─────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────

model AuditLog {
  id             String  @id @default(cuid())
  userId         String
  organizationId String
  action         String
  resource       String
  resourceId     String?
  oldData        Json?
  newData        Json?
  ipAddress      String?
  userAgent      String?

  createdAt DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// CLINIC SETTINGS
// ─────────────────────────────────────────────

model ClinicSettings {
  id             String  @id @default(cuid())
  organizationId String  @unique
  defaultSlotMin Int     @default(20)
  lunchStartTime String?
  lunchEndTime   String?
  timezone       String  @default("Asia/Damascus")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  workingDays  ClinicWorkingDay[]

  @@map("clinic_settings")
}

model ClinicWorkingDay {
  id               String  @id @default(cuid())
  clinicSettingsId String
  dayOfWeek        Int // 0=Sun, 1=Mon … 6=Sat
  startTime        String // "08:00"
  endTime          String // "17:00"
  isOpen           Boolean @default(true)

  clinicSettings ClinicSettings @relation(fields: [clinicSettingsId], references: [id], onDelete: Cascade)

  @@unique([clinicSettingsId, dayOfWeek])
  @@map("clinic_working_days")
}

// ─────────────────────────────────────────────
// VISIT TYPES & SERVICES CATALOG
// ─────────────────────────────────────────────

model VisitType {
  id              String        @id @default(cuid())
  organizationId  String
  name            String
  nameAr          String?
  code            VisitTypeCode
  color           String?
  durationMinutes Int
  basePrice       Decimal?      @db.Decimal(10, 2)
  isActive        Boolean       @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  appointments Appointment[]
  invoiceItems InvoiceItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("visit_types")
}

model Service {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  nameAr         String?
  code           String
  departmentId   String?
  defaultPrice   Decimal @db.Decimal(10, 2)
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  invoiceItems InvoiceItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("services")
}

// ─────────────────────────────────────────────
// DOCTOR SCHEDULES
// ─────────────────────────────────────────────

model DoctorSchedule {
  id        String  @id @default(cuid())
  doctorId  String
  dayOfWeek Int // 0=Sun, 1=Mon … 6=Sat
  startTime String // "08:00"
  endTime   String // "16:00"
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@unique([doctorId, dayOfWeek])
  @@index([doctorId])
  @@map("doctor_schedules")
}

model DoctorScheduleException {
  id        String                @id @default(cuid())
  doctorId  String
  date      DateTime // calendar date stored as midnight UTC
  type      ScheduleExceptionType
  startTime String? // null = full day off
  endTime   String? // null = full day off
  reason    String?

  createdAt DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@unique([doctorId, date])
  @@index([doctorId])
  @@map("doctor_schedule_exceptions")
}

// ─────────────────────────────────────────────
// FOLLOW-UP REMINDERS
// ─────────────────────────────────────────────

model FollowUpReminder {
  id              String                 @id @default(cuid())
  organizationId  String
  patientId       String
  encounterId     String
  appointmentId   String?
  channel         ReminderChannel        @default(IN_APP)
  scheduledFor    DateTime
  status          ReminderStatus         @default(PENDING)
  sentAt          DateTime?
  failureReason   String?
  patientResponse PatientResponseStatus?
  contactNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  encounter    Encounter    @relation(fields: [encounterId], references: [id])
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([organizationId])
  @@index([patientId])
  @@index([encounterId])
  @@index([status, scheduledFor])
  @@map("follow_up_reminders")
}
