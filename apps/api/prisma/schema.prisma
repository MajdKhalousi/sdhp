generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  BRANCH_ADMIN
  DOCTOR
  NURSE
  SECRETARY
  ACCOUNTANT
  TECHNICIAN
}

enum Gender {
  MALE
  FEMALE
}

enum OrganizationType {
  HOSPITAL
  CLINIC
  POLYCLINIC
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

// Platform-level SaaS subscription payment method — deliberately separate
// from PaymentMethod (clinic patient billing). INSURANCE has no meaning here.
enum SubscriptionPaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  ONLINE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_QUEUE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

enum QueueStatus {
  WAITING
  CALLED
  IN_PROGRESS
  DONE
  SKIPPED
}

enum MedicalTimelineEventType {
  PATIENT_CREATED
  PATIENT_UPDATED
  PATIENT_ARCHIVED
  APPOINTMENT_BOOKED
  FOLLOW_UP_BOOKED
  CHECKED_IN
  QUEUE_JOINED
  ENCOUNTER_STARTED
  ENCOUNTER_COMPLETED
  PRESCRIPTION_ADDED
  LAB_ORDERED
  LAB_RESULT_ADDED
  RADIOLOGY_ORDERED
  RADIOLOGY_REPORT_ADDED
  LAB_RESULT_REVIEWED
  RADIOLOGY_REPORT_REVIEWED
  MEDICAL_FILE_UPLOADED
  CLINICAL_REPORT_CREATED
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  IN_PROGRESS
  RESULTED
  REVIEWED
  CANCELLED
}

enum RadiologyOrderStatus {
  ORDERED
  SCHEDULED
  IN_PROGRESS
  RESULTED
  REVIEWED
  CANCELLED
}

enum ClinicalReportStatus {
  DRAFT
  FINALIZED
}

enum VisitTypeCode {
  CONSULTATION
  FOLLOW_UP
  EMERGENCY
  PROCEDURE
  FREE_VISIT
}

enum ScheduleExceptionType {
  HOLIDAY
  LEAVE
  CUSTOM_HOURS
}

enum ReminderChannel {
  IN_APP
  SMS
  WHATSAPP
  EMAIL
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum PatientResponseStatus {
  CONFIRMED
  NO_RESPONSE
  DECLINED
  RESCHEDULE_REQUESTED
}

enum ClinicPatientStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  REVOKED
}

enum ClinicPatientLinkType {
  CLINIC_CREATED
  PATIENT_VERIFIED
  IMPORTED
  INVITED
}

// ─────────────────────────────────────────────
// ORGANIZATIONS & BRANCHES
// ─────────────────────────────────────────────

model Organization {
  id       String           @id @default(cuid())
  name     String
  nameAr   String?
  type     OrganizationType @default(CLINIC)
  phone    String?
  email    String?
  address  String?
  logoUrl  String?
  isActive Boolean          @default(true)
  settings Json             @default("{}")

  subscriptionStatus  SubscriptionStatus @default(ACTIVE)
  subscriptionPlan    String?
  subscriptionStartAt DateTime?
  subscriptionEndAt   DateTime?
  subscriptionNotes   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches              Branch[]
  users                 User[]
  departments           Department[]
  patients              Patient[]
  appointments          Appointment[]
  queueEntries          QueueEntry[]
  auditLogs             AuditLog[]
  labOrders             LabOrder[]
  radiologyOrders       RadiologyOrder[]
  medicalFiles          MedicalFile[]
  invoices              Invoice[]
  medicalTimelineEvents MedicalTimelineEvent[]
  clinicalReports       ClinicalReport[]
  clinicSettings        ClinicSettings?
  visitTypes            VisitType[]
  services              Service[]
  followUpReminders     FollowUpReminder[]
  billingPolicy         BillingPolicy?
  clinicPatients        ClinicPatient[]
  subscriptionPayments  SubscriptionPayment[]
  employeeProfiles      EmployeeProfile[]
  attendanceRecords     AttendanceRecord[]
  leaveRequests         LeaveRequest[]

  @@map("organizations")
}

// Platform-level SaaS subscription payment history — between the platform
// owner (SUPER_ADMIN) and a tenant Organization. Deliberately separate from
// clinic patient billing (Invoice/Payment) — never reused or coupled with it.
// Recording a payment here never auto-updates Organization.subscriptionStatus/
// subscriptionStartAt/subscriptionEndAt/subscriptionPlan/subscriptionNotes —
// those remain independent, manual controls (see Phase 133E/136A).
model SubscriptionPayment {
  id              String                    @id @default(cuid())
  organizationId  String
  amount          Decimal                   @db.Decimal(10, 2)
  currency        String                    @default("SYP")
  method          SubscriptionPaymentMethod
  reference       String?
  notes           String?
  paidAt          DateTime                  @default(now())
  periodStartAt   DateTime?
  periodEndAt     DateTime?
  createdByUserId String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId])
  @@index([paidAt])
  @@map("subscription_payments")
}

model Branch {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  nameAr         String?
  phone          String?
  address        String?
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization     Organization      @relation(fields: [organizationId], references: [id])
  users            User[]
  departments      Department[]
  appointments     Appointment[]
  labOrders        LabOrder[]
  radiologyOrders  RadiologyOrder[]
  invoices         Invoice[]
  employeeProfiles EmployeeProfile[]

  @@index([organizationId])
  @@map("branches")
}

// ─────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  phone          String    @unique
  email          String?   @unique
  passwordHash   String
  firstName      String
  lastName       String
  firstNameAr    String?
  lastNameAr     String?
  role           UserRole  @default(SECRETARY)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization                Organization           @relation(fields: [organizationId], references: [id])
  branch                      Branch?                @relation(fields: [branchId], references: [id])
  doctor                      Doctor?
  auditLogs                   AuditLog[]
  uploadedFiles               MedicalFile[]
  createdInvoices             Invoice[]              @relation("InvoicesCreated")
  receivedPayments            Payment[]              @relation("PaymentsReceived")
  voidedPayments              Payment[]              @relation("PaymentsVoided")
  timelineEventsCreated       MedicalTimelineEvent[] @relation("TimelineEventsCreated")
  createdClinicalReports      ClinicalReport[]
  linkedClinicPatients        ClinicPatient[]        @relation("ClinicPatientLinkedBy")
  createdSubscriptionPayments SubscriptionPayment[]
  employeeProfile             EmployeeProfile?
  uploadedEmployeeDocuments   EmployeeDocument[]
  recordedAttendanceRecords   AttendanceRecord[]
  createdLeaveRequests        LeaveRequest[]         @relation("LeaveCreatedBy")
  decidedLeaveRequests        LeaveRequest[]         @relation("LeaveDecidedBy")

  @@index([organizationId])
  @@map("users")
}

// ─────────────────────────────────────────────
// DEPARTMENTS & STAFF
// ─────────────────────────────────────────────

model Department {
  id             String  @id @default(cuid())
  organizationId String
  branchId       String?
  name           String
  nameAr         String?
  code           String?
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization     Organization      @relation(fields: [organizationId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id])
  doctors          Doctor[]
  services         Service[]
  employeeProfiles EmployeeProfile[]

  @@index([organizationId])
  @@map("departments")
}

model Doctor {
  id                  String  @id @default(cuid())
  userId              String  @unique
  departmentId        String?
  specialization      String?
  licenseNumber       String?
  consultationMinutes Int     @default(15)
  maxPatientsPerDay   Int?
  isActive            Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user                     User                      @relation(fields: [userId], references: [id])
  department               Department?               @relation(fields: [departmentId], references: [id])
  appointments             Appointment[]
  encounters               Encounter[]
  orderedLabOrders         LabOrder[]                @relation("LabOrdersOrdered")
  reviewedLabResults       LabResult[]               @relation("LabResultsReviewed")
  orderedRadiologyOrders   RadiologyOrder[]          @relation("RadiologyOrdersOrdered")
  reportedRadiologyReports RadiologyReport[]         @relation("RadiologyReportsReported")
  reviewedRadiologyReports RadiologyReport[]         @relation("RadiologyReportsReviewed")
  schedules                DoctorSchedule[]
  scheduleExceptions       DoctorScheduleException[]

  @@map("doctors")
}

// ─────────────────────────────────────────────
// EMPLOYEE / HR PROFILES
// ─────────────────────────────────────────────

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum EmployeeDocumentCategory {
  PHOTO
  ID_DOCUMENT
  CONTRACT
  CERTIFICATE
  OTHER
}

// HR/payroll record, deliberately separate from User (login/auth identity).
// userId is optional+unique: an Employee may have no login (HR-only record),
// and a User may have no Employee record (e.g. SUPER_ADMIN platform accounts).
// At most one EmployeeProfile may link to a given User at a time.
model EmployeeProfile {
  id             String  @id @default(cuid())
  organizationId String
  userId         String? @unique
  branchId       String?
  departmentId   String?

  firstName          String
  lastName           String
  firstNameAr        String?
  lastNameAr         String?
  jobTitle           String?
  departmentFreeText String?

  phone       String?
  email       String?
  nationalId  String?
  dateOfBirth DateTime?
  gender      Gender?
  address     String?

  hireDate         DateTime?
  contractStartAt  DateTime?
  contractEndAt    DateTime?
  employmentStatus EmploymentStatus @default(ACTIVE)

  baseSalary Decimal? @db.Decimal(10, 2)
  currency   String   @default("SYP")

  notes String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization      Organization       @relation(fields: [organizationId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
  branch            Branch?            @relation(fields: [branchId], references: [id])
  department        Department?        @relation(fields: [departmentId], references: [id])
  documents         EmployeeDocument[]
  attendanceRecords AttendanceRecord[]
  leaveRequests     LeaveRequest[]

  @@index([organizationId])
  @@index([userId])
  @@index([branchId])
  @@index([departmentId])
  @@map("employee_profiles")
}

// Foundation only — no upload endpoint yet (see Phase 144C). Mirrors the
// MedicalFile/StorageService presigned-URL pattern that will be reused later.
model EmployeeDocument {
  id                String                   @id @default(cuid())
  employeeProfileId String
  category          EmployeeDocumentCategory
  fileName          String
  mimeType          String
  sizeBytes         Int
  storageKey        String                   @unique
  uploadedById      String

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id])
  uploadedBy      User            @relation(fields: [uploadedById], references: [id])

  @@index([employeeProfileId])
  @@index([uploadedById])
  @@map("employee_documents")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

// One record per EmployeeProfile per calendar date — manual ORG_ADMIN entry
// for this phase (no biometric/device integration). organizationId is
// denormalized here (and must always be derived server-side from the
// EmployeeProfile, never trusted from client input) to keep org-scoped
// listing queries simple, matching most other models in this schema.
model AttendanceRecord {
  id                String           @id @default(cuid())
  organizationId    String
  employeeProfileId String
  date              DateTime // calendar date stored as midnight UTC
  status            AttendanceStatus
  checkInAt         DateTime?
  checkOutAt        DateTime?
  notes             String?
  recordedById      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id])
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id])
  recordedBy      User            @relation(fields: [recordedById], references: [id])

  @@unique([employeeProfileId, date])
  @@index([organizationId])
  @@index([employeeProfileId])
  @@index([date])
  @@map("attendance_records")
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// HR/payroll-adjacent record, linked to EmployeeProfile (not User) so
// HR-only employees with no login account can have leave tracked.
// organizationId is denormalized here (always derived server-side from
// EmployeeProfile, never trusted from client input), matching
// AttendanceRecord's convention (Phase 147B). Approving a request never
// auto-updates EmployeeProfile.employmentStatus — that remains a separate,
// manual control until a later phase decides to couple them.
model LeaveRequest {
  id                String      @id @default(cuid())
  organizationId    String
  employeeProfileId String
  type              LeaveType
  startDate         DateTime // calendar date stored as midnight UTC
  endDate           DateTime // calendar date stored as midnight UTC
  status            LeaveStatus @default(PENDING)
  reason            String?
  decisionNote      String?
  decidedById       String?
  decidedAt         DateTime?
  createdById       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id])
  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id])
  decidedBy       User?           @relation("LeaveDecidedBy", fields: [decidedById], references: [id])
  createdBy       User            @relation("LeaveCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([employeeProfileId])
  @@index([status])
  @@map("leave_requests")
}

// ─────────────────────────────────────────────
// PATIENTS
// ─────────────────────────────────────────────

model Patient {
  id              String    @id @default(cuid())
  organizationId  String
  mrn             String
  firstName       String
  lastName        String
  firstNameAr     String?
  lastNameAr      String?
  fatherName      String?
  fatherNameAr    String?
  motherName      String?
  motherNameAr    String?
  dateOfBirth     DateTime?
  gender          Gender?
  phone           String?
  email           String?
  nationalId      String?
  bloodType       String?
  address         String?
  city            String?
  chronicDiseases String?
  emergencyName   String?
  emergencyPhone  String?
  isActive        Boolean   @default(true)
  notes           String?
  platformId      String?   @unique
  hasPortalAccess Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization      Organization           @relation(fields: [organizationId], references: [id])
  allergies         Allergy[]
  appointments      Appointment[]
  encounters        Encounter[]
  labOrders         LabOrder[]
  radiologyOrders   RadiologyOrder[]
  medicalFiles      MedicalFile[]
  invoices          Invoice[]
  clinicalReports   ClinicalReport[]
  timelineEvents    MedicalTimelineEvent[]
  followUpReminders FollowUpReminder[]
  clinicLinks       ClinicPatient[]

  @@unique([organizationId, mrn])
  @@index([organizationId])
  @@index([organizationId, firstName])
  @@index([organizationId, lastName])
  @@index([organizationId, phone])
  @@index([organizationId, nationalId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, isActive])
  @@index([nationalId])
  @@index([phone])
  @@map("patients")
}

model MedicalTimelineEvent {
  id             String                   @id @default(cuid())
  organizationId String
  patientId      String
  createdById    String?
  eventType      MedicalTimelineEventType
  metadata       Json?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  createdBy    User?        @relation("TimelineEventsCreated", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([patientId])
  @@index([organizationId, patientId])
  @@map("medical_timeline_events")
}

model Allergy {
  id        String           @id @default(cuid())
  patientId String
  substance String
  reaction  String?
  severity  AllergySeverity?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("allergies")
}

model ClinicPatient {
  id                    String                @id @default(cuid())
  organizationId        String
  patientId             String
  mrn                   String
  localNotes            String?
  linkType              ClinicPatientLinkType @default(CLINIC_CREATED)
  status                ClinicPatientStatus   @default(ACTIVE)
  registrationSource    String?
  consentGiven          Boolean               @default(false)
  consentAt             DateTime?
  verificationCodeHash  String?
  verificationExpiresAt DateTime?
  linkedAt              DateTime              @default(now())
  linkedById            String?
  lastVisitAt           DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  linkedBy     User?        @relation("ClinicPatientLinkedBy", fields: [linkedById], references: [id])

  @@unique([organizationId, patientId])
  @@unique([organizationId, mrn])
  @@index([organizationId])
  @@index([patientId])
  @@index([organizationId, status])
  @@map("clinic_patients")
}

// ─────────────────────────────────────────────
// APPOINTMENTS & QUEUE
// ─────────────────────────────────────────────

model Appointment {
  id                String            @id @default(cuid())
  organizationId    String
  branchId          String?
  patientId         String
  doctorId          String
  visitTypeId       String?
  sourceEncounterId String?
  scheduledAt       DateTime
  durationMin       Int               @default(15)
  status            AppointmentStatus @default(SCHEDULED)
  notes             String?
  cancelledAt       DateTime?
  cancelReason      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization    Organization       @relation(fields: [organizationId], references: [id])
  branch          Branch?            @relation(fields: [branchId], references: [id])
  patient         Patient            @relation(fields: [patientId], references: [id])
  doctor          Doctor             @relation(fields: [doctorId], references: [id])
  visitType       VisitType?         @relation(fields: [visitTypeId], references: [id])
  sourceEncounter Encounter?         @relation("FollowUpAppointments", fields: [sourceEncounterId], references: [id])
  queueEntry      QueueEntry?
  encounter       Encounter?
  invoices        Invoice[]
  reminders       FollowUpReminder[]

  @@index([organizationId])
  @@index([doctorId])
  @@index([visitTypeId])
  @@index([scheduledAt])
  @@index([patientId])
  @@index([sourceEncounterId])
  @@map("appointments")
}

model QueueEntry {
  id                  String      @id @default(cuid())
  appointmentId       String      @unique
  organizationId      String
  businessDate        String // YYYY-MM-DD in Asia/Damascus — used for daily ticket reset
  ticketNumber        Int
  status              QueueStatus @default(WAITING)
  calledAt            DateTime?
  completedAt         DateTime?
  triageVitals        Json?
  chiefComplaintDraft String?
  deletedAt           DateTime?
  deletedBy           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  appointment  Appointment  @relation(fields: [appointmentId], references: [id])

  @@unique([organizationId, businessDate, ticketNumber])
  @@index([organizationId])
  @@map("queue_entries")
}

// ─────────────────────────────────────────────
// ENCOUNTERS (Medical Visits)
// ─────────────────────────────────────────────

model Encounter {
  id                      String    @id @default(cuid())
  organizationId          String
  branchId                String?
  patientId               String
  doctorId                String
  appointmentId           String?   @unique
  chiefComplaint          String?
  historyOfPresentIllness String?
  notes                   String?
  diagnosis               String?
  diagnosisCode           String?
  treatmentPlan           String?
  patientInstructions     String?
  followUpDate            DateTime?
  vitals                  Json?
  startedAt               DateTime  @default(now())
  endedAt                 DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  patient              Patient            @relation(fields: [patientId], references: [id])
  doctor               Doctor             @relation(fields: [doctorId], references: [id])
  appointment          Appointment?       @relation(fields: [appointmentId], references: [id])
  followUpAppointments Appointment[]      @relation("FollowUpAppointments")
  prescriptions        Prescription[]
  labOrders            LabOrder[]
  radiologyOrders      RadiologyOrder[]
  medicalFiles         MedicalFile[]
  invoices             Invoice[]
  clinicalReports      ClinicalReport[]
  reminders            FollowUpReminder[]

  @@index([organizationId])
  @@index([doctorId])
  @@index([patientId])
  @@index([organizationId, followUpDate])
  @@index([organizationId, doctorId, followUpDate])
  @@map("encounters")
}

// ─────────────────────────────────────────────
// PRESCRIPTIONS
// ─────────────────────────────────────────────

model Prescription {
  id           String  @id @default(cuid())
  encounterId  String
  medication   String
  dosage       String?
  frequency    String?
  duration     String?
  instructions String?
  quantity     Int?
  refillsLeft  Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([encounterId])
  @@map("prescriptions")
}

// ─────────────────────────────────────────────
// LABS
// ─────────────────────────────────────────────

model LabOrder {
  id             String         @id @default(cuid())
  organizationId String
  branchId       String?
  patientId      String
  encounterId    String?
  orderedById    String
  testName       String
  testCode       String?
  clinicalInfo   String?
  status         LabOrderStatus @default(ORDERED)
  priority       String?
  notes          String?
  collectedAt    DateTime?
  cancelReason   String?
  cancelledAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  encounter    Encounter?   @relation(fields: [encounterId], references: [id])
  orderedBy    Doctor       @relation("LabOrdersOrdered", fields: [orderedById], references: [id])
  result       LabResult?

  @@index([organizationId])
  @@index([patientId])
  @@index([encounterId])
  @@index([orderedById])
  @@index([status])
  @@map("lab_orders")
}

model LabResult {
  id             String    @id @default(cuid())
  labOrderId     String    @unique
  resultValue    String?
  unit           String?
  referenceRange String?
  interpretation String?
  resultNotes    String?
  resultAt       DateTime  @default(now())
  reviewedById   String?
  reviewedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  labOrder   LabOrder @relation(fields: [labOrderId], references: [id])
  reviewedBy Doctor?  @relation("LabResultsReviewed", fields: [reviewedById], references: [id])

  @@map("lab_results")
}

// ─────────────────────────────────────────────
// RADIOLOGY
// ─────────────────────────────────────────────

model RadiologyOrder {
  id             String               @id @default(cuid())
  organizationId String
  branchId       String?
  patientId      String
  encounterId    String?
  orderedById    String
  modality       String
  bodyPart       String?
  clinicalInfo   String?
  priority       String?
  notes          String?
  status         RadiologyOrderStatus @default(ORDERED)
  scheduledAt    DateTime?
  cancelReason   String?
  cancelledAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id])
  branch       Branch?          @relation(fields: [branchId], references: [id])
  patient      Patient          @relation(fields: [patientId], references: [id])
  encounter    Encounter?       @relation(fields: [encounterId], references: [id])
  orderedBy    Doctor           @relation("RadiologyOrdersOrdered", fields: [orderedById], references: [id])
  report       RadiologyReport?

  @@index([organizationId])
  @@index([patientId])
  @@index([encounterId])
  @@index([orderedById])
  @@index([status])
  @@map("radiology_orders")
}

model RadiologyReport {
  id               String    @id @default(cuid())
  radiologyOrderId String    @unique
  findings         String?
  impression       String?
  reportedById     String?
  reportedAt       DateTime  @default(now())
  reviewedById     String?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  radiologyOrder RadiologyOrder @relation(fields: [radiologyOrderId], references: [id])
  reportedBy     Doctor?        @relation("RadiologyReportsReported", fields: [reportedById], references: [id])
  reviewedBy     Doctor?        @relation("RadiologyReportsReviewed", fields: [reviewedById], references: [id])

  @@map("radiology_reports")
}

// ─────────────────────────────────────────────
// MEDICAL FILES
// ─────────────────────────────────────────────

enum MedicalFileCategory {
  LAB_RESULT
  RADIOLOGY_IMAGE
  PRESCRIPTION
  REFERRAL
  DISCHARGE_SUMMARY
  CONSENT_FORM
  INSURANCE
  CLINICAL_NOTE
  CLINICAL_REPORT
  ID_DOCUMENT
  OTHER
}

model MedicalFile {
  id             String              @id @default(cuid())
  organizationId String
  patientId      String
  encounterId    String?
  uploadedById   String
  category       MedicalFileCategory
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String              @unique
  description    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  encounter    Encounter?   @relation(fields: [encounterId], references: [id])
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  @@index([organizationId])
  @@index([patientId])
  @@index([encounterId])
  @@index([uploadedById])
  @@index([category])
  @@map("medical_files")
}

// ─────────────────────────────────────────────
// CLINICAL REPORTS
// ─────────────────────────────────────────────

model ClinicalReport {
  id             String               @id @default(cuid())
  organizationId String
  patientId      String
  encounterId    String
  createdById    String
  title          String
  content        String
  status         ClinicalReportStatus @default(DRAFT)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  encounter    Encounter    @relation(fields: [encounterId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([patientId])
  @@index([encounterId])
  @@index([createdById])
  @@index([status])
  @@index([deletedAt])
  @@map("clinical_reports")
}

// ─────────────────────────────────────────────
// BILLING
// ─────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  INSURANCE
  OTHER
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  branchId       String?
  patientId      String
  appointmentId  String?
  encounterId    String?
  createdById    String
  invoiceNumber  String
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(10, 2)
  notes          String?
  issuedAt       DateTime?
  dueDate        DateTime?
  cancelledAt    DateTime?
  cancelReason   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])
  encounter    Encounter?    @relation(fields: [encounterId], references: [id])
  createdBy    User          @relation("InvoicesCreated", fields: [createdById], references: [id])
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([patientId])
  @@index([encounterId])
  @@index([appointmentId])
  @@index([createdById])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  visitTypeId String?
  serviceId   String?
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice   Invoice    @relation(fields: [invoiceId], references: [id])
  visitType VisitType? @relation(fields: [visitTypeId], references: [id])
  service   Service?   @relation(fields: [serviceId], references: [id])

  @@index([invoiceId])
  @@index([visitTypeId])
  @@index([serviceId])
  @@map("invoice_items")
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod
  referenceNumber String?
  notes           String?
  paidAt          DateTime      @default(now())
  receivedById    String
  voidedAt        DateTime?
  voidReason      String?
  voidedById      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  receivedBy User    @relation("PaymentsReceived", fields: [receivedById], references: [id])
  voidedBy   User?   @relation("PaymentsVoided", fields: [voidedById], references: [id])

  @@index([invoiceId])
  @@index([receivedById])
  @@index([voidedById])
  @@map("payments")
}

model BillingPolicy {
  id                            String  @id @default(cuid())
  organizationId                String  @unique
  autoCreateInvoiceOnCheckin    Boolean @default(true)
  freeFollowUpWindowDays        Int     @default(0)
  followUpDiscountPercent       Decimal @default(0) @db.Decimal(5, 2)
  requirePaymentBeforeEncounter Boolean @default(false)
  defaultDueDateDays            Int     @default(0)
  noShowFeeAmount               Decimal @default(0) @db.Decimal(10, 2)
  invoiceNumberPrefix           String  @default("INV")
  nextInvoiceSequence           Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("billing_policies")
}

// ─────────────────────────────────────────────
// AUDIT LOGS
// ─────────────────────────────────────────────

model AuditLog {
  id             String  @id @default(cuid())
  userId         String
  organizationId String
  action         String
  resource       String
  resourceId     String?
  oldData        Json?
  newData        Json?
  ipAddress      String?
  userAgent      String?

  createdAt DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// CLINIC SETTINGS
// ─────────────────────────────────────────────

model ClinicSettings {
  id             String  @id @default(cuid())
  organizationId String  @unique
  defaultSlotMin Int     @default(20)
  lunchStartTime String?
  lunchEndTime   String?
  timezone       String  @default("Asia/Damascus")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  workingDays  ClinicWorkingDay[]

  @@map("clinic_settings")
}

model ClinicWorkingDay {
  id               String  @id @default(cuid())
  clinicSettingsId String
  dayOfWeek        Int // 0=Sun, 1=Mon … 6=Sat
  startTime        String // "08:00"
  endTime          String // "17:00"
  isOpen           Boolean @default(true)

  clinicSettings ClinicSettings @relation(fields: [clinicSettingsId], references: [id], onDelete: Cascade)

  @@unique([clinicSettingsId, dayOfWeek])
  @@map("clinic_working_days")
}

// ─────────────────────────────────────────────
// VISIT TYPES & SERVICES CATALOG
// ─────────────────────────────────────────────

model VisitType {
  id              String        @id @default(cuid())
  organizationId  String
  name            String
  nameAr          String?
  code            VisitTypeCode
  color           String?
  durationMinutes Int
  basePrice       Decimal?      @db.Decimal(10, 2)
  isActive        Boolean       @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  appointments Appointment[]
  invoiceItems InvoiceItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("visit_types")
}

model Service {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  nameAr         String?
  code           String
  departmentId   String?
  defaultPrice   Decimal @db.Decimal(10, 2)
  isActive       Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  invoiceItems InvoiceItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("services")
}

// ─────────────────────────────────────────────
// DOCTOR SCHEDULES
// ─────────────────────────────────────────────

model DoctorSchedule {
  id        String  @id @default(cuid())
  doctorId  String
  dayOfWeek Int // 0=Sun, 1=Mon … 6=Sat
  startTime String // "08:00"
  endTime   String // "16:00"
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@unique([doctorId, dayOfWeek])
  @@index([doctorId])
  @@map("doctor_schedules")
}

model DoctorScheduleException {
  id        String                @id @default(cuid())
  doctorId  String
  date      DateTime // calendar date stored as midnight UTC
  type      ScheduleExceptionType
  startTime String? // null = full day off
  endTime   String? // null = full day off
  reason    String?

  createdAt DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id])

  @@unique([doctorId, date])
  @@index([doctorId])
  @@map("doctor_schedule_exceptions")
}

// ─────────────────────────────────────────────
// FOLLOW-UP REMINDERS
// ─────────────────────────────────────────────

model FollowUpReminder {
  id              String                 @id @default(cuid())
  organizationId  String
  patientId       String
  encounterId     String
  appointmentId   String?
  channel         ReminderChannel        @default(IN_APP)
  scheduledFor    DateTime
  status          ReminderStatus         @default(PENDING)
  sentAt          DateTime?
  failureReason   String?
  patientResponse PatientResponseStatus?
  contactNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])
  encounter    Encounter    @relation(fields: [encounterId], references: [id])
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([organizationId])
  @@index([patientId])
  @@index([encounterId])
  @@index([status, scheduledFor])
  @@map("follow_up_reminders")
}
