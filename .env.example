# ================================
# SDHP — Root Environment Example
# ================================
# Copy this to .env and fill in real values.
# Each app also has its own .env.example inside apps/api/ and apps/web/.

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sdhp?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# MinIO (Object Storage)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="sdhp-files"

# JWT
JWT_SECRET="change-this-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="7d"

# App
NODE_ENV="development"
API_PORT=3001
FRONTEND_URL="http://localhost:3000"
