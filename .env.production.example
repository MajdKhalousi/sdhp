# ─────────────────────────────────────────────────────────────
# SDHP — Production Environment Template
# Copy to .env.production and fill in ALL values before deploying.
# NEVER commit .env.production to git.
# ─────────────────────────────────────────────────────────────

# ── Domain ──────────────────────────────────────────────────
# The public-facing domain name (used by nginx + Next.js + CORS)
DOMAIN=clinic.example.com

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=sdhp_prod
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=sdhp_production

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_random_password

# ── MinIO (Object Storage) ────────────────────────────────────
MINIO_ROOT_USER=sdhp_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_random_password
MINIO_BUCKET=sdhp-files

# ── JWT ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_EXPIRES_IN=7d

# ── Next.js build arg (baked into the web Docker image) ──────
# Must match https://${DOMAIN}/api
NEXT_PUBLIC_API_URL=https://clinic.example.com/api
