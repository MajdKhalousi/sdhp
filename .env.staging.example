# ─────────────────────────────────────────────────────────────
# SDHP — Staging Environment Template
# Copy to .env.staging and fill in ALL values before deploying.
# NEVER commit .env.staging to git.
# NEVER copy values from production's .env / .env.production — every
# value here must be generated fresh for staging.
# See: docs/00-Company/Decisions/Decision-011-No-Dev-Testing-on-Production-Host.md
# ─────────────────────────────────────────────────────────────

# ── Domain ──────────────────────────────────────────────────
# The public-facing staging domain (used by nginx + Next.js + CORS)
DOMAIN=staging.elajihealth.com

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=sdhp_staging
POSTGRES_PASSWORD=CHANGE_ME_generate_fresh_staging_password
POSTGRES_DB=sdhp_staging

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_generate_fresh_staging_password

# ── MinIO (Object Storage) ────────────────────────────────────
MINIO_ROOT_USER=sdhp_staging_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_generate_fresh_staging_password
MINIO_BUCKET=sdhp-staging-files
MINIO_PUBLIC_ENDPOINT=https://staging.elajihealth.com/minio

# ── JWT ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_EXPIRES_IN=24h

# ── Next.js build arg (baked into the web Docker image) ──────
# Must match https://${DOMAIN}/api
NEXT_PUBLIC_API_URL=https://staging.elajihealth.com/api

# ── Integrations — disabled/dummy on staging ─────────────────
# Placeholders only: no real notification/payment code path is wired to
# these yet (see docs/01-Product/Feature-Matrix.md), but staging must
# never be the environment that fires a first real integration by accident.
EMAIL_ENABLED=false
SMS_ENABLED=false
PAYMENTS_ENABLED=false
