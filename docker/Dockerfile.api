# ─────────────────────────────────────────────
# Builder
# ─────────────────────────────────────────────
FROM node:22-alpine AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@11.1.2 --activate

# Required so native dependencies (e.g. bcrypt) can compile from source when
# no prebuilt binary matches this exact Alpine/musl/Node ABI combination —
# without these, pnpm's allowBuilds for bcrypt still runs the build script,
# but it has nothing to compile with, and silently leaves the native
# binding missing while the rest of the package installs fine.
RUN apk add --no-cache python3 make g++

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/

RUN pnpm install --frozen-lockfile --node-linker=hoisted

COPY apps/api ./apps/api

RUN pnpm --filter @sdhp/api exec prisma generate
RUN pnpm --filter @sdhp/api run build

# ─────────────────────────────────────────────
# Runner
# ─────────────────────────────────────────────
FROM node:22-alpine AS runner

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NODE_ENV=production

RUN apk add --no-cache \
    openssl \
    libc6-compat \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    font-noto \
    font-noto-arabic \
    font-noto-naskh-arabic

ENV CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser

RUN corepack enable && corepack prepare pnpm@11.1.2 --activate

WORKDIR /app

RUN addgroup --system --gid 1001 sdhp \
 && adduser --system --uid 1001 sdhp

COPY --from=builder --chown=sdhp:sdhp /app/node_modules ./node_modules
COPY --from=builder --chown=sdhp:sdhp /app/apps/api ./apps/api

COPY --chown=sdhp:sdhp docker/scripts/docker-entrypoint.api.sh ./apps/api/entrypoint.sh

RUN chmod +x ./apps/api/entrypoint.sh

USER sdhp

WORKDIR /app/apps/api

EXPOSE 3001

ENTRYPOINT ["./entrypoint.sh"]
