# ─────────────────────────────────────────────────────────────
# Stage 1 — base: enable pnpm via corepack
# ─────────────────────────────────────────────────────────────
FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.1.2 --activate

# ─────────────────────────────────────────────────────────────
# Stage 2 — builder: install deps + compile
# ─────────────────────────────────────────────────────────────
FROM base AS builder
WORKDIR /repo

# Copy workspace manifests — enables Docker layer caching for deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json     ./apps/web/
COPY packages/shared/package.json ./packages/shared/

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# Copy source
COPY apps/web     ./apps/web
COPY packages     ./packages

# Build-time env: API URL is baked in at build time for Next.js public vars
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_TELEMETRY_DISABLED=1

RUN pnpm --filter @sdhp/web run build

# ─────────────────────────────────────────────────────────────
# Stage 3 — runner: minimal image using Next.js standalone output
# ─────────────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Non-root user
RUN addgroup --system --gid 1001 sdhp \
 && adduser  --system --uid 1001 sdhp

# Next.js standalone bundle (self-contained — includes its own node_modules)
COPY --from=builder --chown=sdhp:sdhp /repo/apps/web/.next/standalone ./

# Static assets and public files (not included in standalone)
COPY --from=builder --chown=sdhp:sdhp /repo/apps/web/.next/static  ./apps/web/.next/static
COPY --from=builder --chown=sdhp:sdhp /repo/apps/web/public         ./apps/web/public

USER sdhp
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD wget -qO- http://localhost:3000/ || exit 1

# Standalone output server (generated by Next.js when output: 'standalone')
CMD ["node", "apps/web/server.js"]
