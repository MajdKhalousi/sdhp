# Docker services — default local dev values
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sdhp

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=sdhp-files

# API storage config (passed via docker-compose or apps/api/.env for local dev without Docker)
# MINIO_ENDPOINT=localhost        # hostname only, no port; 'minio' in prod docker-compose
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=minioadmin     # matches MINIO_ROOT_USER
# MINIO_SECRET_KEY=minioadmin     # matches MINIO_ROOT_PASSWORD
# MINIO_BUCKET=sdhp-files
# MINIO_PUBLIC_ENDPOINT=https://elajihealth.com/minio  # browser-reachable base for presigned URLs; omit in local dev
