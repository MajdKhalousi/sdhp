# ==============================
# SDHP API — Environment Example
# ==============================
# Copy this file to .env and fill in the values.
# Only DATABASE_URL and JWT_SECRET are required to run the API.

# ── Database (required) ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sdhp?schema=public"

# ── Auth (required) ────────────────────────────────────────────────────────────
JWT_SECRET="change-this-in-production"
JWT_EXPIRES_IN="7d"

# ── Server (required) ──────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT=3001
FRONTEND_URL="http://localhost:3000"

# ── Optional / future use ──────────────────────────────────────────────────────
# Redis is not used by the API yet. Included here for future caching support.
# REDIS_URL="redis://localhost:6379"
